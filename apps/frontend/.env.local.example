# URL da API NestJS (server-side e client-side apontam para o mesmo backend local)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Auth.js
AUTH_SECRET="CHANGE_ME_dev_only_secret"
AUTH_URL="http://localhost:3000"

# IP do visitante assinado nas chamadas server-side ao backend (throttle por IP). Mesmo valor do
# CLIENT_IP_SECRET do backend (32+ caracteres, openssl rand -hex 32). Opcional em dev; obrigatório
# em produção no backend. Atrás de nginx/Caddy (1 proxy) TRUSTED_PROXY_HOPS=1 (padrão).
# CLIENT_IP_SECRET="CHANGE_ME_min_32_chars_generate_with_openssl_rand_hex_32"
# TRUSTED_PROXY_HOPS=1
