# Postgres — usado por packages/database e apps/api
DATABASE_URL="postgresql://totalagenda_app:totalagenda_dev@localhost:5432/totalagenda_dev?schema=public"

# apps/backend
PORT=3001
JWT_SECRET="CHANGE_ME_dev_only_secret"
JWT_EXPIRES_IN="12h"
FRONTEND_URL="http://localhost:3000"

# Integração com o Admin-TotalSoftware (checkout/billing reais vivem lá agora).
# TOTALAGENDA_WEBHOOK_SECRET autentica os webhooks de provisionamento e sincronização de
# assinatura que o Admin-TotalSoftware chama neste backend (ver apps/backend/src/webhooks).
TOTALAGENDA_WEBHOOK_SECRET="CHANGE_ME_shared_webhook_secret"
# URL pública deste backend usada pelo Admin-TotalSoftware para chamar os webhooks acima
# (não é lida pelo código, é só documentação do contrato entre os dois repos).
TOTALAGENDA_PROVISION_WEBHOOK_URL="https://api.totalagenda.com.br/webhooks/totalsoftware"

# apps/frontend
# URL da landing page externa (TotalSoftware) para onde os CTAs de compra apontam.
NEXT_PUBLIC_LANDING_URL="https://totalsoftware.com.br/produtos"
