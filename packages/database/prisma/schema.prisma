generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  OWNER
  PROFESSIONAL
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum BookingStatus {
  CONFIRMED
  CANCELED
  COMPLETED
}

enum WaitlistStatus {
  PENDING
  CONTACTED
  RESOLVED
  CANCELED
}

enum PlanTier {
  ESSENCIAL
  PROFISSIONAL
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

// ─────────────────────────────────────────────
// Tenant / Auth
// ─────────────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  trialEndsAt DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  users         User[]
  professionals Professional[]
  services      Service[]
  bookings      Booking[]
  timeBlocks    TimeBlock[]
  waitlist      WaitlistEntry[]
  subscription  Subscription?

  @@index([slug])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional?

  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Profissionais e disponibilidade
// ─────────────────────────────────────────────

model Professional {
  id                     String   @id @default(cuid())
  tenantId               String
  userId                 String   @unique
  bio                    String?
  isActive               Boolean  @default(true)
  slotGranularityMinutes Int      @default(15)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingHours         WorkingHours[]
  timeBlocks           TimeBlock[]
  bookings             Booking[]
  professionalServices ProfessionalService[]
  waitlistEntries      WaitlistEntry[]

  @@index([tenantId, isActive])
}

model WorkingHours {
  id             String   @id @default(cuid())
  professionalId String
  weekday        Weekday
  startMinute    Int
  endMinute      Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, weekday, startMinute])
  @@index([professionalId, weekday])
}

model TimeBlock {
  id             String   @id @default(cuid())
  tenantId       String
  professionalId String
  startAt        DateTime @db.Timestamptz(6)
  endAt          DateTime @db.Timestamptz(6)
  reason         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, startAt, endAt])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Catálogo de serviços
// ─────────────────────────────────────────────

model Service {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalServices ProfessionalService[]
  bookings             Booking[]
  waitlistEntries      WaitlistEntry[]

  @@index([tenantId, isActive])
}

model ProfessionalService {
  id              String   @id @default(cuid())
  professionalId  String
  serviceId       String
  durationMinutes Int?
  priceCents      Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
}

// ─────────────────────────────────────────────
// Agendamentos
// ─────────────────────────────────────────────

model Booking {
  id                 String        @id @default(cuid())
  tenantId           String
  professionalId     String
  serviceId          String
  clientName         String
  clientPhone        String
  startAt            DateTime      @db.Timestamptz(6)
  endAt              DateTime      @db.Timestamptz(6)
  priceCentsSnapshot Int
  status             BookingStatus @default(CONFIRMED)
  manageToken        String        @unique
  canceledAt         DateTime?     @db.Timestamptz(6)
  rescheduledCount   Int           @default(0)
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([tenantId, startAt])
  @@index([professionalId, startAt])
  // Constraint EXCLUDE anti-overlap é adicionada manualmente na migration SQL (ver migration.sql)
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  tenantId       String
  serviceId      String
  professionalId String?
  clientName     String
  clientPhone    String
  preferredDate  DateTime?      @db.Date
  notes          String?
  status         WaitlistStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

// ─────────────────────────────────────────────
// Billing (Stripe)
// ─────────────────────────────────────────────

model Plan {
  id               String   @id @default(cuid())
  tier             PlanTier @unique
  name             String
  priceCents       Int
  maxProfessionals Int?
  stripePriceId    String   @unique
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  planId               String
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodEnd     DateTime           @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)
}
