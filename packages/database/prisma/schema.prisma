generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  OWNER
  PROFESSIONAL
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum BookingStatus {
  CONFIRMED
  CANCELED
  COMPLETED
}

enum WaitlistStatus {
  PENDING
  CONTACTED
  RESOLVED
  CANCELED
}

enum PlanTier {
  ESSENCIAL
  PROFISSIONAL
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

// ─────────────────────────────────────────────
// Tenant / Auth
// ─────────────────────────────────────────────

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  trialEndsAt DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  // Id do cliente no sistema externo (Admin-TotalSoftware) que originou este tenant via
  // webhook de provisionamento. Nulo para tenants criados via cadastro trial local.
  externalCustomerId Int? @unique

  // Perfil público exibido em /[slug] — todos opcionais, editados pelo dono no dashboard.
  description     String?
  address         String?
  businessHours   String? // texto livre (ex: "Seg-Sex 9h-19h"), não agregado automaticamente
  logoUrl         String? // caminho servido pelo backend, ex: /uploads/tenants/<id>/logo.webp
  accentColor     String? // hex "#RRGGBB"; nulo usa o rosa padrão do TotalAgenda
  whatsappNumber  String? // só dígitos, com DDI (ex: 5511912345678) — vira link wa.me
  instagramUrl    String?

  // Cada seção aparece automaticamente se tiver conteúdo (serviços cadastrados, fotos na
  // galeria, etc.) — esses toggles deixam o dono escondê-la mesmo assim.
  showServices Boolean @default(true)
  showTeam     Boolean @default(true)
  showGallery  Boolean @default(true)
  showContact  Boolean @default(true)

  users         User[]
  professionals Professional[]
  services      Service[]
  bookings      Booking[]
  timeBlocks    TimeBlock[]
  waitlist      WaitlistEntry[]
  subscription  Subscription?
  clients       Client[]
  galleryImages TenantGalleryImage[]

  @@index([slug])
}

// Fotos avulsas da página pública (espaço, trabalhos feitos) — separado de logoUrl porque
// é 0..N por tenant, não 1.
model TenantGalleryImage {
  id        String   @id @default(uuid())
  tenantId  String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, position])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  // Convite de "definir senha" emitido quando o Admin-TotalSoftware provisiona este usuário
  // via webhook (ver WebhooksService.provisionar) — ele nasce com uma senha aleatória
  // descartada e só consegue logar depois de consumir este token. Guardamos o hash, nunca o
  // token em claro (mesmo padrão do passwordHash).
  passwordSetTokenHash      String?   @unique
  passwordSetTokenExpiresAt DateTime? @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional?

  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Profissionais e disponibilidade
// ─────────────────────────────────────────────

model Professional {
  id                     String   @id @default(uuid())
  tenantId               String
  userId                 String   @unique
  bio                    String?
  isActive               Boolean  @default(true)
  slotGranularityMinutes Int      @default(15)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingHours         WorkingHours[]
  timeBlocks           TimeBlock[]
  bookings             Booking[]
  professionalServices ProfessionalService[]
  waitlistEntries      WaitlistEntry[]

  @@index([tenantId, isActive])
}

model WorkingHours {
  id             String   @id @default(uuid())
  professionalId String
  weekday        Weekday
  startMinute    Int
  endMinute      Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, weekday, startMinute])
  @@index([professionalId, weekday])
}

model TimeBlock {
  id             String   @id @default(uuid())
  tenantId       String
  professionalId String
  startAt        DateTime @db.Timestamptz(6)
  endAt          DateTime @db.Timestamptz(6)
  reason         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, startAt, endAt])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Catálogo de serviços
// ─────────────────────────────────────────────

model Service {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalServices ProfessionalService[]
  bookings             Booking[]
  waitlistEntries      WaitlistEntry[]

  @@index([tenantId, isActive])
}

model ProfessionalService {
  id              String   @id @default(uuid())
  professionalId  String
  serviceId       String
  durationMinutes Int?
  priceCents      Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
}

// ─────────────────────────────────────────────
// Agendamentos
// ─────────────────────────────────────────────

model Booking {
  id                 String        @id @default(uuid())
  tenantId           String
  professionalId     String
  serviceId          String
  // Snapshot do momento do agendamento (auditoria, mesmo padrão de priceCentsSnapshot) —
  // não editado depois. A identidade "viva" do cliente é a relação clientId abaixo.
  clientName         String
  clientPhone        String
  clientId           String?
  startAt            DateTime      @db.Timestamptz(6)
  endAt              DateTime      @db.Timestamptz(6)
  priceCentsSnapshot Int
  status             BookingStatus @default(CONFIRMED)
  manageToken        String        @unique
  canceledAt         DateTime?     @db.Timestamptz(6)
  rescheduledCount   Int           @default(0)
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([tenantId, startAt])
  @@index([professionalId, startAt])
  @@index([clientId])
  // Constraint EXCLUDE anti-overlap é adicionada manualmente na migration SQL (ver migration.sql)
}

model WaitlistEntry {
  id             String         @id @default(uuid())
  tenantId       String
  serviceId      String
  professionalId String?
  clientName     String
  clientPhone    String
  clientId       String?
  preferredDate  DateTime?      @db.Date
  notes          String?
  status         WaitlistStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

// ─────────────────────────────────────────────
// Clientes finais (quem agenda) — identidade por telefone, escopada por tenant
// ─────────────────────────────────────────────
// Criado/atualizado automaticamente a cada agendamento público (upsert por
// [tenantId, phone] normalizado), o que permite login "só por telefone" sem cadastro
// prévio: o primeiro agendamento já cria a conta. v1 não tem verificação (OTP) — ver
// ClientAuthService no backend para o racional e o ponto de extensão futuro.
model Client {
  id        String   @id @default(uuid())
  tenantId  String
  phone     String // normalizado: só dígitos, sem DDI 55
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────
// A cobrança real (checkout, portal, ciclo do Stripe) vive no Admin-TotalSoftware.
// Este backend só mantém o "espelho" necessário para aplicar limites por plano
// (PlanLimitService) e liberar/bloquear acesso (TenantBillingGuard), atualizado pelos
// webhooks de provisionamento/sincronização em src/webhooks.

model Plan {
  id               String   @id @default(uuid())
  tier             PlanTier @unique
  name             String
  priceCents       Int
  maxProfessionals Int?
  stripePriceId    String   @unique
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  planId               String
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  // Nula quando a origem (provisionamento) não informa a próxima cobrança; preenchida a
  // partir de "proximaCobranca" pelo webhook de sincronização de status.
  currentPeriodEnd     DateTime?          @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)
}
